# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# lockfiles from other package managers — this project uses yarn
package-lock.json
pnpm-lock.yaml
bun.lockb

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
*.pem

# editors
.idea/
.vscode/
*.swp
*.swo

# local tool config (machine-specific, holds local permissions)
.claude/settings.local.json

# caches
.eslintcache
.turbo/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
